node_modules/
.env
.env.local
*.log

# Rendered media is large and reproducible; only the queue metadata is tracked.
media/inbox/*
media/broll/*
media/music/*
media/out/*
!media/*/.gitkeep

# npm needs the lockfile tracked. Stated explicitly because while this project sits
# inside another repository, that repository's .gitignore excludes lockfiles.
!package-lock.json

# Local editor and OS noise
.DS_Store
Thumbs.db
.vscode/
